# Порт сервера (по умолчанию 3000).
# Допустимо целое 0–65535; любое другое значение — сервер завершится с кодом 1.
PORT=3000

# Режим демонстрации: разрешает сканирование localhost
# В продакшене НЕ включать, требует NODE_ENV=development
DEMO_MODE=false

# Origin фронтенда для CORS (для локальной разработки — http://localhost:3000).
# Обязателен, если сервер не на Render: без него процесс завершится с кодом 1.
PUBLIC_ORIGIN=http://localhost:3000

# На Render эта переменная подставляется автоматически для веб-сервисов и
# используется как fallback, если PUBLIC_ORIGIN не задан. Задавать вручную не нужно.
# RENDER_EXTERNAL_URL=https://<service>.onrender.com

# Окружение: development | production
# DEMO_MODE разрешён только при NODE_ENV=development
# В продакшене ставить NODE_ENV=production
NODE_ENV=development

# Секрет для HMAC-подписи токенов согласия (crypto.createHmac("sha256")).
# Обязателен при NODE_ENV=production: без него процесс завершится с кодом 1.
# В development при отсутствии подставляется небезопасный dev-секрет.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# При смене секрета все ранее выданные токены (TTL 15 минут) станут недействительны.
CONSENT_SECRET=dev-secret-do-not-use-in-prod

# Trust proxy: число доверенных прокси перед сервером, целое 0–10.
# 0 — прямой доступ (локально). 1 — за одним прокси (Render, nginx).
# true, мусор и значения вне диапазона завершают процесс с кодом 1.
# Значение больше числа реальных прокси отдаёт req.ip из X-Forwarded-For.
TRUST_PROXY=0